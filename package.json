{
  "name": "rhetorical-modes-deck",
  "version": "1.0.0",
  "private": true,
  "description": "Academic Reading and Writing — Rhetorical Modes lecture deck (Slidev, deck2video-ready).",
  "scripts": {
    "dev": "slidev slides.md --open",
    "build": "slidev build slides.md --base ./",
    "export": "slidev export slides.md --format pdf",
    "export:png": "slidev export slides.md --format png"
  },
  "dependencies": {
    "@slidev/cli": "^0.50.0",
    "@slidev/theme-default": "^0.25.0",
    "playwright-chromium": "^1.49.0",
    "vue": "^3.5.0"
  }
}
